    "@iconify-json/fxemoji": "^1.2.2",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/gis": "^1.2.6",
    "@iconify-json/healthicons": "^1.2.18",
    "@iconify-json/icon-park": "^1.2.4",
    "@iconify-json/iconoir": "^1.2.12",
