{
  "name": "gorsel-zihin-haritasi",
  "private": true,
  "version": "1.1.3",
  "description": "Telefon, Tablet ve Bilgisayar uyumlu 4 Katmanlı Sonsuz Görsel Motorlu Zihin Haritası Uygulaması",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-offline-icon-shards.mjs",
    "dev": "vite",
    "prebuild": "node scripts/clean-dist.mjs dist && node scripts/build-offline-icon-shards.mjs",
    "build": "tsc -b && vite build",
    "generate:icons": "node scripts/generate-app-icons-and-splash.mjs",
    "ios:prepare": "npm run generate:icons && npm run build && npx cap sync ios",
    "ios:ship": "bash scripts/ios-build-and-upload.sh",
    "appstore:create-cert": "node scripts/create-apple-dist-cert.mjs",
    "appstore:api-sync": "node scripts/appstore-connect-api-submit.mjs",
    "appstore:submit": "node scripts/appstore-connect-api-submit.mjs --submit",
    "appstore:screenshots": "node scripts/capture-appstore-screenshots.mjs",
    "verify:search": "node scripts/verify-search-relevance.mjs",
    "verify:appstore": "node scripts/verify-appstore-readiness.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.6.10",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.0",
    "@capacitor/status-bar": "^7.0.6",
    "@supabase/supabase-js": "^2.49.1",
    "dexie": "^4.0.11",
    "fflate": "^0.8.3",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.475.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.5.438",
    "rbush": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "workbox-window": "^7.4.1",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.24"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@iconify-json/carbon": "^1.2.30",
