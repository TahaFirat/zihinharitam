{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zihinharitam-ai-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_PRO_DAILY_LIMIT": "35",
    "ALLOWED_ORIGINS": "capacitor://localhost,https://localhost,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173"
  }
}
