# ZihinHaritam Ücretsiz Çoklu Yapay Zeka Sağlayıcı Ayarları
# Bu dosyayı `.env` olarak kopyalayıp ücretsiz aldığınız anahtarları ekleyin.
# ASLA `.env` dosyasını GitHub'a yüklemeyin (.gitignore ile korunur)!
# Birden fazla ücretsiz anahtar eklerseniz kota dolduğunda sistem otomatik sonraki sağlayıcıya geçer.

# 1) Cerebras Free Tier (1.000.000 token/gün ücretsiz, kredi kartı yok): https://cloud.cerebras.ai
# CEREBRAS_API_KEY=

# 2) Groq Free Tier (Llama 3.3 70B + Llama 3.1 8B, 600K token/gün ücretsiz): https://console.groq.com
# GROQ_API_KEY=

# 3) Google AI Studio / Gemini Flash-Lite (Ücretsiz, uzun PDF desteği): https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# 4) Cloudflare Workers AI (10.000 Neurons/gün ücretsiz): https://dash.cloudflare.com
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# 5) OpenRouter Free Models (opsiyonel ek yedek): https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Günlük Pro üye başı adil kullanım kotası (AI sadece Pro üyelere açıktır; önbellek isabetleri kotadan düşmez!)
AI_PRO_DAILY_LIMIT=35
