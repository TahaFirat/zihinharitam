{
  "name": "zihinharitam-web-platform",
  "private": true,
  "version": "1.1.3",
  "description": "ZihinHaritam Tam Kapsamlı Web Uygulaması, OWASP Sertleştirmeli Hesap/Bulut Sunucusu ve Güvenli Paylaşım Platformu",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "dev:web": "vite --config vite.config.ts --port 5174",
    "start": "node --no-warnings=ExperimentalWarning server/index.mjs",
    "test:security": "node --no-warnings=ExperimentalWarning tests/security-penetration.test.mjs"
  }
}
